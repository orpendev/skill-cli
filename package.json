{
  "name": "orpen-skill-cli",
  "version": "0.0.3",
  "description": "CLI for installing audited skills/agents from the Orpen registry into local AI coding agents (Claude Code, Codex).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/orpendev/skill-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orpendev/skill-cli.git"
  },
  "bugs": "https://github.com/orpendev/skill-cli/issues",
  "keywords": [
    "ai",
    "agents",
    "skills",
    "claude-code",
    "codex",
    "registry",
    "cli"
  ],
  "bin": {
    "orpen-skill-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
